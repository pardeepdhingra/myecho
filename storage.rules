rules_version = '2';
// Per-user asset storage (word photos + sign videos). Reads and writes scoped to the owner;
// writes capped at 10 MB. Shared iOS + Android contract — Part A5 of CLOUD_SYNC_PLAN.md.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
